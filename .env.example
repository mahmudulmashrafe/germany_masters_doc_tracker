# Supabase Configuration
# Obtain these from your Supabase Dashboard -> Project Settings -> API

# Project URL (e.g. https://your-project-ref.supabase.co)
SUPABASE_URL="https://your-project-ref.supabase.co"
VITE_SUPABASE_URL="https://your-project-ref.supabase.co"

# Supabase Publishable / Anon Key (e.g. sb_publishable_... or eyJhbGci...)
SUPABASE_PUBLISHABLE_KEY="your-anon-or-publishable-key-here"
VITE_SUPABASE_PUBLISHABLE_KEY="your-anon-or-publishable-key-here"

# (Optional) Supabase Project Ref ID
SUPABASE_PROJECT_ID="your-project-ref"
VITE_SUPABASE_PROJECT_ID="your-project-ref"
